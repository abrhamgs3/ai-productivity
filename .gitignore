# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ============================================================
# Virtual environments & package managers
# ============================================================
.venv/
venv/
env/
ENV/
.uv/

# ============================================================
# Testing & linting
# ============================================================
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.ruff_cache/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ============================================================
# Research data
# Data files are large and reproducible — track structure only.
# Add individual files to a DVC manifest or separate data repo.
# ============================================================
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
data/interim/
data/external/

# Keep directory structure
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# ============================================================
# Generated pipeline outputs
# Everything in tables/ and figures/ is regenerated by
# `ai-productivity run`. Do not commit generated artifacts.
# ============================================================
tables/*.txt
tables/*.csv
tables/*.tex
tables/*.json
figures/*.png
figures/*.pdf

# Keep directory structure
!tables/.gitkeep
!figures/.gitkeep

# ============================================================
# Paper: LaTeX source is tracked; compiled outputs are not.
# ============================================================

# LaTeX build artefacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.toc

# Compiled PDFs and Word docs — binary, not diffable
# LaTeX source (.tex) IS tracked; the compiled output is not.
paper/*.pdf
paper/*.docx
paper/*build*.pdf

# ============================================================
# Submission package — duplicated PDFs/DOCX, not tracked
# ============================================================
submission_package/

# ============================================================
# OS & editor
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
*.swp
*.swo

# ============================================================
# Secrets
# ============================================================
.env
.env.*
secrets.yaml
